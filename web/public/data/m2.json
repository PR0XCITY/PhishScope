{"id":2,"title":"Random Variables and Bayes","syllabus_module":"Module 2","question":"If a red flag fires, how likely is the email to be phishing?","code":[{"label":"PMF, CDF, E[X] and Var[X] of n_urls","file":"analysis/02_random_variables.R","start_line":21,"code":"# X = n_urls: PMF, CDF (display capped at 10+), E[X], Var[X] on raw values.\npmf_by_class <- do.call(rbind, lapply(classes, function(cl) {\n  data.frame(class = cl, pmf_capped(train$n_urls[train$class == cl], cap = 10))\n}))\nmoments_x <- t(sapply(classes, function(cl) rv_moments(train$n_urls[train$class == cl])))"},{"label":"Joint PMF of has_url x has_urgency","file":"analysis/02_random_variables.R","start_line":44,"code":"# Joint PMF of has_url x has_urgency within phishing and within legitimate.\njoint <- lapply(c(phishing = \"phishing\", legitimate = \"legitimate\"), function(cl) {\n  d <- train[train$class == cl, ]\n  joint_pmf(d$has_url, d$has_urgency, \"has_url\", \"has_urgency\")\n})"},{"label":"Bayes P(phishing | feature) at sample and 1% prior","file":"analysis/02_random_variables.R","start_line":52,"code":"# P(feature | class) and Bayes P(phishing | feature) at sample and 1% prevalence.\nis_phish <- train$class == \"phishing\"\nprior_sample <- mean(is_phish)\ncond <- t(sapply(binary_features, function(f) tapply(train[[f]] == 1, train$class, mean)))\nbayes <- data.frame(\n  feature = binary_features,\n  p_f_phish = sapply(binary_features, function(f) mean(train[[f]][is_phish] == 1)),\n  p_f_not_phish = sapply(binary_features, function(f) mean(train[[f]][!is_phish] == 1))\n)\nbayes$post_sample <- bayes_posterior(bayes$p_f_phish, bayes$p_f_not_phish, prior_sample)\nbayes$post_1pct <- bayes_posterior(bayes$p_f_phish, bayes$p_f_not_phish, 0.01)\nbayes$lift_1pct <- bayes$post_1pct / 0.01"},{"label":"Covariance and correlation matrices","file":"analysis/02_random_variables.R","start_line":75,"code":"# Covariance and correlation of numeric features.\ncov_mat <- stats::cov(train[numeric_features])\ncor_mat <- stats::cor(train[numeric_features])\nspearman_mat <- stats::cor(train[numeric_features], method = \"spearman\")"},{"label":"MGF: empirical vs Poisson, moments from derivatives","file":"analysis/02_random_variables.R","start_line":91,"code":"# MGF of X: empirical vs Poisson(lambda = mean), t in [0, 0.5]; moments from derivatives.\nt_grid <- seq(0, 0.5, by = 0.01)\nmgf_curves <- do.call(rbind, lapply(classes, function(cl) {\n  x <- train$n_urls[train$class == cl]\n  rbind(data.frame(class = cl, t = t_grid, model = \"empirical\",\n                   log_m = log_empirical_mgf(x, t_grid)),\n        data.frame(class = cl, t = t_grid, model = \"Poisson\",\n                   log_m = log_poisson_mgf(mean(x), t_grid)))\n}))\nmgf_moment_tbl <- do.call(rbind, lapply(classes, function(cl) {\n  x <- train$n_urls[train$class == cl]\n  # Step scaled to max(x) so h * max(x) stays small despite the heavy tail.\n  emp <- mgf_moments(function(t) log_empirical_mgf(x, t), h = 0.01 / max(x))\n  poi <- mgf_moments(function(t) log_poisson_mgf(mean(x), t))\n  data.frame(class = cl, mgf_mean = emp[[\"mean\"]], mgf_var = emp[[\"var\"]],\n             direct_mean = mean(x), direct_var = rv_moments(x)[[\"var\"]],\n             poisson_var = poi[[\"var\"]])\n}))"},{"label":"PMF and CDF of a count variable","file":"R/rv.R","start_line":38,"code":"# PMF and CDF of a count variable, values >= cap pooled into \"cap+\".\npmf_capped <- function(x, cap = 10) {\n  k <- pmin(x, cap)\n  p <- tabulate(k + 1, nbins = cap + 1) / length(k)\n  data.frame(\n    value = c(as.character(0:(cap - 1)), paste0(cap, \"+\")),\n    k = 0:cap, pmf = p, cdf = cumsum(p)\n  )\n}"},{"label":"Bayes rule","file":"R/rv.R","start_line":61,"code":"# P(C | F) = P(F | C) P(C) / [P(F | C) P(C) + P(F | not C) (1 - P(C))]\nbayes_posterior <- function(p_f_given_c, p_f_given_not_c, prior) {\n  num <- p_f_given_c * prior\n  num / (num + p_f_given_not_c * (1 - prior))\n}"},{"label":"Moment generating function and its derivatives","file":"R/rv.R","start_line":78,"code":"# log M(t) via log-sum-exp so heavy tails do not overflow.\nlog_empirical_mgf <- function(x, t) {\n  vapply(t, function(ti) {\n    z <- ti * x\n    zmax <- max(z)\n    zmax + log(mean(exp(z - zmax)))\n  }, numeric(1))\n}\n\nlog_poisson_mgf <- function(lambda, t) {\n  lambda * (exp(t) - 1)\n}\n\n# Mean and variance from central differences of M(t) at t = 0.\nmgf_moments <- function(log_mgf, h = 1e-4) {\n  m <- exp(log_mgf(c(-h, 0, h)))\n  d1 <- (m[3] - m[1]) / (2 * h)\n  d2 <- (m[3] - 2 * m[2] + m[1]) / h^2\n  c(mean = d1, var = d2 - d1^2)\n}"}],"console":["The tzdb package is not installed. Timezones will not be available to Arrow compute functions. If you get errors when using Arrow on datetimes, try running `install.packages('tzdb')` and trying again.","E[X], Var[X] of n_urls by class:","            mean     var","legitimate 1.724 416.207","phishing   0.478   7.731","spam       2.295  46.387","","P(has_url, has_urgency = 1, 1): phishing 0.157 | legitimate 0.036 ","","Bayes P(phishing | feature), sample prior 0.0591 and 1%:","          feature p_f_phish p_f_not_phish post_sample post_1pct","          has_url  0.270366      4.00e-01     0.04076   0.00679","           ip_url  0.001181      2.08e-03     0.03448   0.00571","    shortener_url  0.001476      9.09e-04     0.09259   0.01614","        at_in_url  0.006494      4.29e-02     0.00941   0.00153","      has_urgency  0.516529      7.29e-02     0.30788   0.06675","   has_credential  0.742031      7.31e-02     0.38941   0.09301","        has_money  0.564050      4.97e-02     0.41643   0.10293"," generic_greeting  0.322609      8.36e-03     0.70790   0.28042","         has_html  0.000295      1.85e-05     0.50000   0.13852","     subject_caps  0.264758      8.99e-03     0.64906   0.22922","","P(phishing | has_credential) = (0.7420 x 0.0591) / (0.7420 x 0.0591 + 0.0731 x 0.9409) = 0.0439 / 0.1126 = 0.3894","P(phishing | has_credential) = (0.7420 x 0.0100) / (0.7420 x 0.0100 + 0.